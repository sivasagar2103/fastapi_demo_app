# Docker Compose reads rest_api/.env. Local Python processes need exported variables.
MYSQL_ROOT_PASSWORD=LocalRootPassword123!
MYSQL_DATABASE=management_demo
MYSQL_USER=management_app
MYSQL_PASSWORD=LocalAppPassword123!
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_DEMO=true
DEMO_PASSWORD=ChangeThisDemoPassword123!
# Optional advanced override (URL-encode credentials):
# DATABASE_URL=mysql+aiomysql://management_app:password@127.0.0.1:3306/management_demo?charset=utf8mb4

# Azure AI Foundry resource hosting an OpenAI-compatible chat deployment.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=

# RabbitMQ and exchange-rate worker
RABBITMQ_HOST=127.0.0.1
RABBITMQ_USER=management_worker
RABBITMQ_PASSWORD=ChangeRabbitPassword123!
EXCHANGE_RATES_API_KEY=
